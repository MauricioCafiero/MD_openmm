# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
*.egg-link
.eggs/
build/
dist/
*.so

# --- virtual envs ---
.venv/
venv/
env/

# --- generated outputs (keep the folder, ignore contents) ---
outputs/*
!outputs/.gitkeep

# --- MD artifacts (in case they're written outside outputs/) ---
*.dcd
*.xtc
*.nc
*.chk
*.csv
!**/requirements.csv

# --- rotaxane generated artifacts (regenerate from rotaxanes/*.py) ---
rotaxanes/outputs/
rotaxanes/metad/metad_run/
rotaxanes/*.sdf
rotaxanes/metad/plumed.dat
rotaxanes/metad/HILLS
rotaxanes/metad/COLVAR
rotaxanes/metad/*.log

# --- MM/GBSA scratch (antechamber + MMPBSA.py write these to cwd) ---
ANTECHAMBER_*.AC*
ATOMTYPE.INF
sqm.in
sqm.out
sqm.pdb
reference.frc
leap.log
_MMPBSA_*

# --- editor / OS ---
.DS_Store
.idea/
.vscode/
*.swp
*~

# --- large inputs you may not want tracked ---
data/**/*.pdb.bak
data/**/*.ent

# --- local machine-specific notes (not for the public repo) ---
LOCAL_NOTES.md